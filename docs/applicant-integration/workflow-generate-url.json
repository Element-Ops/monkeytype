      "id": "build-token",
      "name": "Build Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300],
      "parameters": {
        "language": "javaScript",
        "jsCode": "// HARDCODED SECRET — replace placeholder before activating, never commit to git\nconst SECRET = 'REPLACE_WITH_32_PLUS_CHAR_HMAC_SECRET';\nconst BASE_URL = 'https://typing.elementops.it.com';\nconst TTL_DAYS = 30;\n\nconst crypto = require('crypto');\nconst body = $input.first().json.body || $input.first().json;\nconst recordId = body.recordId || body.record_id;\n\nif (!recordId || typeof recordId !== 'string' || !recordId.startsWith('rec')) {\n  throw new Error('missing or invalid recordId in webhook body');\n}\n\nconst nowSec = Math.floor(Date.now() / 1000);\nconst expiresAtSec = nowSec + TTL_DAYS * 86400;\nconst nonce = crypto.randomBytes(8).toString('hex');\n\nconst payload = { r: recordId, e: expiresAtSec, n: nonce };\nconst tokenB64 = Buffer.from(JSON.stringify(payload)).toString('base64url');\nconst sig = crypto.createHmac('sha256', SECRET).update(tokenB64).digest('hex');\nconst token = tokenB64 + '.' + sig;\nconst url = BASE_URL + '/?t=' + token;\n\nreturn [{\n  json: {\n    recordId: recordId,\n    token: token,\n    url: url,\n    expiresAt: new Date(expiresAtSec * 1000).toISOString(),\n    generatedAt: new Date(nowSec * 1000).toISOString()\n  }\n}];"
      }
    },
